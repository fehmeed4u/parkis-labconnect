[{"id":"p1","title":"Acid–base titration (NaOH / HCl)","grade":11,"subject":"Chemistry","course":"A Level","topic":"Quantitative chemistry","kit":[{"itemId":"i0218","name":"Burette with stopclock 50 mL","perGroup":1},{"itemId":"i0223","name":"Erlenmeyer/conical flask 250 mL","perGroup":2},{"itemId":"i0793","name":"sodium hydroxide","perGroup":1,"conc":"0.1 M","vol":100},{"itemId":"i0696","name":"hydrochloric acid","perGroup":1,"conc":"0.1 M","vol":50},{"itemId":"i0763","name":"phenolphthalein","perGroup":1}],"prepMinutes":45,"method":"1. Rinse the burette with hydrochloric acid, then fill it to the 0.00 cm³ mark.\n2. Pipette 25.0 cm³ of sodium hydroxide into a conical flask and add 3 drops of phenolphthalein.\n3. Add the acid from the burette, swirling, until the pink colour just disappears.\n4. Repeat until two titres agree within 0.10 cm³."},{"id":"p2","title":"Food tests","grade":9,"subject":"Double Science","course":"IGCSE","topic":"Nutrition","kit":[{"itemId":"i0204","name":"Beaker 250 mL","perGroup":1},{"itemId":"i0632","name":"Biuret reagent","perGroup":1},{"itemId":"i0628","name":"Benedict","perGroup":1},{"itemId":"i0705","name":"iodine solution","perGroup":1}],"prepMinutes":30,"method":"1. Test each food for starch (iodine), reducing sugar (Benedict’s in a water bath) and protein (biuret).\n2. Record the colour changes."},{"id":"p3","title":"Paper chromatography of inks","grade":9,"subject":"Chemistry","course":"IGCSE","topic":"Separating mixtures","kit":[{"itemId":"i0204","name":"Beaker 250 mL","perGroup":1}],"prepMinutes":15,"method":""},{"id":"p4","title":"Osmosis in potato cylinders","grade":10,"subject":"Biology","course":"IGCSE","topic":"Transport in cells","kit":[{"itemId":"i0580","name":"Cork borer set","perGroup":1},{"itemId":"i0070","name":"Balance 500 g × 0.1","perGroup":1}],"prepMinutes":30,"method":""},{"id":"p5","title":"Specific heat capacity","grade":9,"subject":"Physics","course":"IGCSE","topic":"Energy","kit":[{"itemId":"i0325","name":"Blo